# ==============================================================================
# StreamVox Live Frontend - Environment Variables Template
# ==============================================================================

# Supabase Project Credentials (Authentication & PostgreSQL RLS Sync)
# Obtain these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: Custom ASGI Backend Server URL (defaults to window.location.origin)
# NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
