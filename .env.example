# TikTok Live Configuration
TIKTOK_USERNAME=@your_channel_handle

# Fish Audio Application Programming Interface (API) Configuration (Free Developer Tier)
FISH_AUDIO_API_KEY=your_fish_audio_api_key_here
FISH_AUDIO_MODEL_ID=9c110ffde8bc42709516395dfbcfb4a2
FISH_AUDIO_TIER_MODEL=s2.1-pro-free

# Fallback Text-to-Speech (TTS) Configuration (Microsoft Neural TTS)
ENABLE_FALLBACK_TTS=true
FALLBACK_VOICE=th-TH-NiwatNeural

# Google Colaboratory (Colab) / Hugging Face (HF) Spaces Acceleration Tunnel Configuration (Optional)
# Public tunnel Uniform Resource Locator (URL) endpoint (e.g. Hugging Face Spaces or Cloudflare Tunnel)
COLAB_TUNNEL_URL=
# Network timeout threshold in seconds before falling back to local synthesis
COLAB_TTS_TIMEOUT_SECONDS=2.0
# Prioritize Google Colab / Hugging Face Spaces endpoint over local fallback
PREFER_COLAB_TTS=true
# Hugging Face (HF) Spaces Bearer Token Authentication (Optional for private/rate-limited spaces)
# HF_TOKEN=hf_your_token_here
HF_TOKEN=

# Audio Routing Configuration (Virtual Audio Cable: VAC)
AUDIO_OUTPUT_DEVICE_NAME=CABLE Input (VB-Audio Virtual Cable)

# Moderation & Playback Parameters (First-In, First-Out: FIFO Queue)
MAX_COMMENT_LENGTH=80
USER_COOLDOWN_SECONDS=15
MAX_QUEUE_SIZE=10
MIN_GIFT_COINS=1

# Operating System (OS) Emergency Hotkey
EMERGENCY_HOTKEY=f9

# Audio Cache Directory
CACHE_DIR=.cache/audio
