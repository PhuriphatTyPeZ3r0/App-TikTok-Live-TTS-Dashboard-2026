# Environment variables and secrets
.env
.env.*
!.env.example

# Audio and local caches
.cache/
*.mp3
*.wav

# Python artifacts
__pycache__/
*.py[cod]
*.pyc
*$py.class
*.so

# Virtual environments
venv/
.venv/
env/
ENV/

# Testing and coverage artifacts
.pytest_cache/
.coverage
htmlcov/

# Build artifacts
dist/
build/
*.egg-info/

# Cloudflare wrangler cache
cloudflare-gateway/.wrangler/
.wrangler/

# Superpowers execution directory
.superpowers/

# Node.js and Next.js artifacts
node_modules/
frontend/node_modules/
.next/
frontend/.next/
frontend/next-env.d.ts

# Shipped assets (the gift chime and voice prompts) are tracked despite the audio rules above
!assets/*.wav
!colab/assets/*.mp3
!huggingface-space/assets/*.mp3

