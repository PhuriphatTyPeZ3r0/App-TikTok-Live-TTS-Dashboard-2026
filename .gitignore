# Environment variables and secrets
.env
.env.*
!.env.example

# Audio and local caches
.cache/
*.mp3
*.wav

# Python artifacts
__pycache__/
*.py[cod]
*.pyc
*$py.class
*.so

# Virtual environments
venv/
.venv/
env/
ENV/

# Testing and coverage artifacts
.pytest_cache/
.coverage
htmlcov/

# Build artifacts
dist/
build/
*.egg-info/

# Cloudflare wrangler cache
cloudflare-gateway/.wrangler/
.wrangler/

# Superpowers execution directory
.superpowers/

# Shipped assets (the gift chime) are tracked despite the *.wav rule above
!assets/*.wav
